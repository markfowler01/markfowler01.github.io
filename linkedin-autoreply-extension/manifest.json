{
  "manifest_version": 3,
  "name": "LinkedIn Auto-Reply (Personal)",
  "version": "1.0.0",
  "description": "Drafts and sends short replies for new connections, birthdays and job changes inside your own LinkedIn session, with daily caps, delays and approval mode.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LinkedIn Auto-Reply — open dashboard",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_page": "app.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
